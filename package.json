{
  "name": "biwa-press",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "build:ssg": "cross-env BIWA_RENDER_MODE=ssg BIWA_OUT_DIR=build/ssg vite build",
    "build:ssr": "cross-env BIWA_RENDER_MODE=ssr BIWA_OUT_DIR=build/ssr vite build",
    "build:csr": "cross-env BIWA_RENDER_MODE=csr BIWA_OUT_DIR=build/csr vite build",
    "package:ssg": "bash scripts/package-ssg.sh",
    "package:ssr": "bash scripts/package-ssr.sh",
    "package:csr": "bash scripts/package-csr.sh",
    "setup:prod": "npm install --omit=dev",
    "preview": "npm run preview:ssg",
    "preview:ssg": "cross-env BIWA_RENDER_MODE=ssg BIWA_OUT_DIR=build/ssg vite preview",
    "preview:ssr": "node build/ssr/index.js",
    "preview:csr": "cross-env BIWA_RENDER_MODE=csr BIWA_OUT_DIR=build/csr vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "download:fonts": "node scripts/download-fonts.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.3.0",
    "@shikijs/transformers": "^1.29.2",
    "@types/unist": "^3.0.3",
    "bits-ui": "^2.18.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0",
    "mdast-util-to-string": "^4.0.0",
    "mdsvex": "^0.12.0",
    "mdsvex-relative-images": "^2.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "shiki": "^1.0.0",
    "svelte-i18n": "^4.0.1",
    "sveltekit-sitemap": "^1.0.21",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.59.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.0.0",
    "prettier": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "esbuild": "^0.25.0"
  }
}
